{
  "name": "claude-stones",
  "version": "1.0.0",
  "description": "Generate a tailored Claude Code setup (.claude/, AGENT.md, ROADMAP.md) for any project",
  "type": "module",
  "bin": {
    "stones": "bin/stones.mjs",
    "claude-stones": "bin/stones.mjs"
  },
  "files": [
    "bin/",
    "cli/*.mjs",
    "!cli/*.test.mjs",
    "hooks/*.mjs",
    "hooks/*.sh",
    "hooks/lib/*.mjs",
    "!hooks/*.test.*",
    "tools/*.mjs",
    "!tools/*.test.mjs",
    "settings/*.json",
    "!settings/settings.json",
    "skills/",
    "devcontainer/",
    "graph/",
    "commands/",
    "mcps/",
    "analyzers/",
    "AGENT.md",
    "setup.bash"
  ],
  "scripts": {
    "test": "node --test hooks/ cli/ tools/",
    "test:hooks": "node --test hooks/",
    "build:settings": "node settings/build-settings.mjs",
    "build:devcontainers": "node cli/devcontainer.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "hooks",
    "scaffold"
  ],
  "author": "ALOUANI YOUSSEF",
  "license": "MIT"
}
