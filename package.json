{
  "name": "@alouani-youssef/harness-stones",
  "version": "1.1.0",
  "description": "Generate a tailored Claude Code setup (.claude/, AGENT.md, ROADMAP.md) for any project",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alouani-youssef/stones.git"
  },
  "homepage": "https://github.com/alouani-youssef/stones#readme",
  "bugs": {
    "url": "https://github.com/alouani-youssef/stones/issues"
  },
  "type": "module",
  "bin": {
    "stones": "bin/stones.mjs"
  },
  "files": [
    "bin/",
    "cli/*.mjs",
    "!cli/*.test.mjs",
    "hooks/*.mjs",
    "hooks/*.sh",
    "hooks/lib/*.mjs",
    "!hooks/*.test.*",
    "tools/*.mjs",
    "!tools/*.test.mjs",
    "settings/*.json",
    "!settings/settings.json",
    "skills/",
    "devcontainer/",
    "graph/",
    "commands/",
    "mcps/",
    "analyzers/",
    "AGENT.md",
    "setup.bash"
  ],
  "scripts": {
    "test": "node --test hooks/ cli/ tools/",
    "test:hooks": "node --test hooks/",
    "build:settings": "node settings/build-settings.mjs",
    "build:devcontainers": "node cli/devcontainer.mjs",
    "check": "node scripts/check-repo.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "hooks",
    "scaffold"
  ],
  "author": "ALOUANI YOUSSEF",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}