{
  "allow": [
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)",
    "Bash(git show:*)",
    "Bash(git branch --show-current)",
    "Bash(git branch --list:*)",
    "Bash(git branch -a)",
    "Bash(git branch -v)",
    "Bash(git branch -vv)"
  ],
  "ask": [
    "Bash(git push:*)"
  ],
  "deny": [
    "Read(./.env)",
    "Read(./.env.local)",
    "Read(./private/**)"
  ]
}
