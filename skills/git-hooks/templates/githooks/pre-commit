#!/usr/bin/env bash
# pre-commit: format, then lint, the staged files. Formatted files are re-staged.
# Fill the commands with the project's own; an empty command skips that step.
# Each command gets the staged file paths that match FILE_PATTERN as arguments.
set -euo pipefail

FILE_PATTERN=""   # extended regex for the files the tools handle, e.g. \.(ts|tsx|js)$ | \.py$ | \.go$ (empty: all)
FORMAT_CMD=""     # e.g. npx prettier --write | ruff format | gofmt -w
LINT_CMD=""       # e.g. npx eslint | ruff check

# while-read loops rather than mapfile, which macOS's bash 3.2 lacks.
files=()
while IFS= read -r file; do
  if [ -z "$FILE_PATTERN" ] || printf '%s\n' "$file" | grep -Eq "$FILE_PATTERN"; then files+=("$file"); fi
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#files[@]}" -eq 0 ] && exit 0

if [ -n "$FORMAT_CMD" ]; then
  # Files that also have unstaged changes are formatted but not re-staged, so
  # changes the developer left out of this commit stay out of it.
  partial=" $(git diff --name-only | tr '\n' ' ') "
  echo "pre-commit: $FORMAT_CMD"
  # shellcheck disable=SC2086 # the command is intentionally word-split
  $FORMAT_CMD "${files[@]}"
  for file in "${files[@]}"; do
    case "$partial" in
      *" $file "*) echo "pre-commit: $file is partly staged; review the formatter's changes and stage them yourself" >&2 ;;
      *) git add -- "$file" ;;
    esac
  done
fi

if [ -n "$LINT_CMD" ]; then
  echo "pre-commit: $LINT_CMD"
  # shellcheck disable=SC2086
  $LINT_CMD "${files[@]}"
fi
